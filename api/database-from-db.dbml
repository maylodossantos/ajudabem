Table "flyway_schema_history" {
  "installed_rank" int4 [pk, not null]
  "version" varchar(50)
  "description" varchar(200) [not null]
  "type" varchar(20) [not null]
  "script" varchar(1000) [not null]
  "checksum" int4
  "installed_by" varchar(100) [not null]
  "installed_on" timestamp [not null, default: `now()`]
  "execution_time" int4 [not null]
  "success" bool [not null]

  Indexes {
    success [type: btree, name: "flyway_schema_history_s_idx"]
  }
}

Table "users" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "name" varchar(255)
  "email" varchar(255)
  "password" varchar(255)
  "phone" varchar(255)
  "profile_image" varchar(255)
  "cpf" varchar(11) [unique]
  "role" int2 [check: `(role >= 0) AND (role <= 2)`]
  "birth_date" date
  "last_login_at" timestamp
  "terms_accepted_at" timestamp
  "reset_password_code" varchar(255)
  "reset_password_code_expires_at" timestamp
  "reset_password_token" varchar(255)
  "reset_password_token_expires_at" timestamp
}

Table "tags" {
  "id" int8 [pk, not null]
  "name" varchar(255)
  "deleted" bool [not null, default: false]
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
}

Table "news" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "author_user_id" int8 [not null]
  "title" varchar(255)
  "subtitle" varchar(255)
  "content" varchar(10000)
  "cover_image" varchar(500)
  "city" varchar(100)
  "state" varchar(2)
}

Table "assisted_people" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "created_user_id" int8 [not null]
  "full_name" varchar(255)
  "age" int4
  "gender" int2 [check: `(gender >= 0) AND (gender <= 2)`]
  "risk_level" int2 [check: `(risk_level >= 0) AND (risk_level <= 2)`]
  "notes" varchar(255)
  "street" varchar(255)
  "number" varchar(255)
  "neighborhood" varchar(255)
  "city" varchar(255)
  "state" varchar(255)
  "zip_code" varchar(255)
  "country" varchar(255)
  "care_status" varchar(20) [not null, default: 'NOMINATED']
  "organization_id" int8
  "care_started_at" timestamp
  "care_updated_at" timestamp
  "finish_reason" varchar(40)
  "latitude" float8
  "longitude" float8
}

Table "assisted_person_tags" {
  "assisted_person_id" int8 [not null]
  "tag_id" int8 [not null]

  Indexes {
    (assisted_person_id, tag_id) [pk, type: btree, name: "pk_assisted_person_tags"]
  }
}

Table "organizations" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "owner_user_id" int8 [unique, not null]
  "corporate_name" varchar(150)
  "trade_name" varchar(150)
  "cnpj" varchar(14) [unique]
  "activity_area" varchar(100)
  "street" varchar(255)
  "number" varchar(20)
  "neighborhood" varchar(100)
  "city" varchar(100)
  "state" varchar(2)
  "zip_code" varchar(8)
  "website" varchar(255)
  "instagram" varchar(100)
  "status" varchar(20) [not null, check: `(status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[])`]
  "submitted_at" timestamp
  "reviewed_at" timestamp
  "reviewed_by_user_id" int8
  "rejection_reason" varchar(40)
  "rejection_note" varchar(1000)
  "latitude" float8
  "longitude" float8
}

Table "organization_documents" {
  "organization_id" int8 [not null]
  "type" varchar(40) [not null]
  "file_name" varchar(255) [not null]
  "content_type" varchar(100) [not null]
  "size_bytes" int8 [not null]
  "sent_at" timestamp

  Indexes {
    (organization_id, type) [pk, type: btree, name: "pk_organization_documents"]
  }
}

Table "organization_document_files" {
  "organization_id" int8 [not null]
  "type" varchar(40) [not null]
  "content" bytea [not null]

  Indexes {
    (organization_id, type) [pk, type: btree, name: "pk_organization_document_files"]
  }
}

Table "help_points" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "name" varchar(150) [not null]
  "description" varchar(1000)
  "cover_image" varchar(500)
  "organization_type" varchar(30) [not null]
  "street" varchar(255)
  "number" varchar(20)
  "neighborhood" varchar(100)
  "city" varchar(100)
  "state" varchar(2)
  "zip_code" varchar(8)
  "latitude" float8
  "longitude" float8
  "phone" varchar(20)
  "whatsapp" varchar(20)
  "email" varchar(255)
  "responsible" varchar(255)
  "schedule_note" varchar(255)
  "notes" varchar(1000)
  "source" varchar(20) [not null]
  "external_id" varchar(50)
}

Table "help_point_services" {
  "help_point_id" int8 [not null]
  "service" varchar(30) [not null]

  Indexes {
    (help_point_id, service) [pk, type: btree, name: "pk_help_point_services"]
  }
}

Table "help_point_opening_hours" {
  "help_point_id" int8 [not null]
  "day_of_week" varchar(10) [not null]
  "opens_at" time [not null]
  "closes_at" time [not null]
}

Table "care_records" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "assisted_person_id" int8 [not null]
  "author_user_id" int8 [not null]
  "number" int4 [not null]
  "status" varchar(20) [not null]
  "occurred_at" timestamp [not null]
  "situation" varchar(2000)
  "action_taken" varchar(2000)
  "referral" varchar(2000)
  "next_step" varchar(2000)
  "summary" varchar(2000)
  "note" varchar(2000)
  "finish_reason" varchar(40)
}

Table "campaigns" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "organization_id" int8 [not null]
  "title" varchar(150) [not null]
  "donation_info" varchar(2000)
  "subtitle" varchar(300)
  "description" varchar(5000) [not null]
  "category" varchar(30) [not null]
  "goal_amount" numeric(12,2)
  "deadline" date
  "cover_image" varchar(500)
  "status" varchar(20) [not null]
  "finished_at" timestamp
}

Table "volunteer_actions" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "organization_id" int8 [not null]
  "title" varchar(150) [not null]
  "action_date" date [not null]
  "start_time" time [not null]
  "end_time" time [not null]
  "volunteers_needed" int4 [not null]
  "street" varchar(255) [not null]
  "number" varchar(20)
  "city" varchar(100) [not null]
  "state" varchar(2) [not null]
  "zip_code" varchar(8)
  "description" varchar(2000) [not null]
  "tasks" varchar(2000)
  "requirements" varchar(2000)
  "notes" varchar(2000)
  "status" varchar(20) [not null]
  "finished_at" timestamp
}

Table "volunteer_applications" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "action_id" int8 [not null]
  "volunteer_user_id" int8 [not null]
  "status" varchar(20) [not null]
}

Table "notifications" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "recipient_user_id" int8 [not null]
  "type" varchar(40) [not null]
  "title" varchar(150) [not null]
  "message" varchar(500) [not null]
  "target_id" int8
  "read_at" timestamp

  Indexes {
    (recipient_user_id, created_at) [type: btree, name: "idx_notifications_recipient"]
  }
}

Table "risk_triage_logs" {
  "id" int8 [pk, not null]
  "deleted" bool
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp
  "assisted_person_id" int8 [not null]
  "risk_level" varchar(10) [not null]
  "justification" varchar(2000)
  "model" varchar(100) [not null]
  "input" varchar(4000) [not null]
  "duration_ms" int8 [not null]

  Indexes {
    (assisted_person_id, created_at) [type: btree, name: "idx_risk_triage_logs_person"]
  }
}

Ref "fk_assisted_people_author":"users"."id" <? "assisted_people"."created_user_id"

Ref "fk_assisted_people_organization":"organizations"."id" ?<? "assisted_people"."organization_id"

Ref "fk_assisted_person_tags_assisted_person":"assisted_people"."id" <? "assisted_person_tags"."assisted_person_id"

Ref "fk_assisted_person_tags_tag":"tags"."id" <? "assisted_person_tags"."tag_id"

Ref "fk_campaigns_organization":"organizations"."id" <? "campaigns"."organization_id"

Ref "fk_care_records_assisted_person":"assisted_people"."id" <? "care_records"."assisted_person_id"

Ref "fk_care_records_author":"users"."id" <? "care_records"."author_user_id"

Ref "fk_help_point_opening_hours_help_point":"help_points"."id" <? "help_point_opening_hours"."help_point_id"

Ref "fk_help_point_services_help_point":"help_points"."id" <? "help_point_services"."help_point_id"

Ref "fk_news_author":"users"."id" <? "news"."author_user_id"

Ref "fk_notifications_recipient":"users"."id" <? "notifications"."recipient_user_id"

Ref "fk_organization_document_files_organization":"organizations"."id" <? "organization_document_files"."organization_id"

Ref "fk_organization_documents_organization":"organizations"."id" <? "organization_documents"."organization_id"

Ref "fk_organizations_owner":"users"."id" <? "organizations"."owner_user_id"

Ref "fk_organizations_reviewer":"users"."id" ?<? "organizations"."reviewed_by_user_id"

Ref "fk_risk_triage_logs_assisted_person":"assisted_people"."id" <? "risk_triage_logs"."assisted_person_id"

Ref "fk_volunteer_actions_organization":"organizations"."id" <? "volunteer_actions"."organization_id"

Ref "fk_volunteer_applications_action":"volunteer_actions"."id" <? "volunteer_applications"."action_id"

Ref "fk_volunteer_applications_volunteer":"users"."id" <? "volunteer_applications"."volunteer_user_id"
